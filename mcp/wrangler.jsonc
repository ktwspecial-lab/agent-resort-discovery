{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-resort-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "services": [{"binding": "RESORT_API", "service": "agent-resort-public"}],
  "ratelimits": [{"name": "MCP_RATE_LIMITER", "namespace_id": "731205", "simple": {"limit": 60, "period": 60}}],
  "observability": {"enabled": true}
}
